APP_ENV=development
APP_URL=http://localhost:8000

# Recommended: use a single DB_URL when connecting to local or hosted MySQL/
# MariaDB services.
# Example: mysql://app_user:secret@127.0.0.1:3306/digital_library?ssl-mode=REQUIRED
DB_URL=

# Legacy / explicit settings used when DB_URL is empty.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=digital_library
DB_USER=library_user
DB_PASS=change-me

SESSION_TIMEOUT=1800
MAX_ACTIVE_LOANS=5
LOAN_DAYS=14
FINE_DAILY_RATE=1.00
FINE_GRACE_DAYS=0
FINE_MAX_AMOUNT=100.00
UPLOAD_MAX_BYTES=2097152
